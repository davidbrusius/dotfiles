// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "reveal_if_open": true,
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "theme": "Rosé Pine Dawn",
  "base_keymap": "VSCode",
  "buffer_font_family": "Victor Mono",
  "buffer_font_weight": 500,
  "buffer_font_features": {
    "calt": true, // Enable ligatures => <> </>
  },
  "ui_font_family": "Victor Mono",
  "ui_font_weight": 500,
  "ui_font_features": {
    "calt": true, // Enable ligatures => <> </>
  },
  "buffer_font_size": 22,
  "agent_ui_font_size": 22,
  "ui_font_size": 22,
  "project_panel": {
    "dock": "left",
    "indent_size": 22,
  },
  "tab_size": 2,
  "file_finder": {
    "modal_max_width": "medium",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_size": 18,
    "alternate_scroll": "on",
    "copy_on_select": true,
  },
  "agent": {
    "threads_sidebar": {
      "auto_open": false
    },
    "dock": "right",
    "enabled": true,
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-opus-4.7",
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "languages": {
    "Python": {
      "formatter": {
        "external": {
          "command": "black",
          "arguments": ["-"],
        },
      },
      "format_on_save": "on",
    },
    "YAML": {
      "format_on_save": "off",
      "enable_language_server": false,
    },
  },
  "file_types": {
    "HCL": ["alloy"],
    "Helm": ["tpl"],
    "Shell Script": ["bats"],
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
}
