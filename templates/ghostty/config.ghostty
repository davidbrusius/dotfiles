# Ghostty configuration

# Appearance
#theme = Rose Pine Dawn
font-family = Victor Mono
font-style = SemiBold
font-size = 20

# Customization
quit-after-last-window-closed = true
scrollback-limit = 50000000
copy-on-select = clipboard
mouse-hide-while-typing = true

# Keybindings
# Make Option+Delete send Ctrl+W (delete previous word in Codex).
keybind = alt+backspace=text:\x17

# Cmd+K sends Ctrl+L so the app inside the terminal clears itself.
# Ghostty's default clear_screen can't clear herdr panes (herdr redraws over it).
keybind = cmd+k=text:\x0c

# Allow Cmd+V to paste into Ghostty's search bar.
keybind = super+v=paste_from_clipboard